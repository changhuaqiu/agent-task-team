{
  "name": "agent-task-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:project-context": "node scripts/run-project-context-benchmark.mjs",
    "eval:project-context:live": "node scripts/collect-project-context-live-e2e.mjs",
    "observability:phoenix:smoke": "tsx scripts/smoke-phoenix-export.ts",
    "e2e": "playwright test",
    "e2e:autonomous": "playwright test --config=playwright.autonomous.config.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "hook:github:install": "node scripts/install-github-issue-hook.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.59.0",
    "@agentclientprotocol/codex-acp": "1.1.2",
    "@agentclientprotocol/sdk": "1.2.1",
    "@dagrejs/dagre": "3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.11.2",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tree-kill": "^1.2.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
